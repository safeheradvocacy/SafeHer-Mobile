# SafeSpace RBAC probe — test account configuration
#
# Copy this file to `.test-accounts.env` (same directory) and fill it in.
# `.test-accounts.env` is gitignored and must NEVER be committed or pasted
# into a chat transcript, an email, or the assessment report.
#
# Use DISPOSABLE accounts created specifically for this assessment.
# Never put a real staff member's working credentials in here.
# Delete every account listed here once the assessment is finished.

SUPABASE_URL=https://qhhcqehgwpzeycejgevk.supabase.co
SUPABASE_ANON_KEY=

# One account per line, pipe-separated:
#   ACCT_<n>=<role>|<label>|<email>|<password>
#
# <role>  must match the account's real role in user_profiles. The harness
#         re-reads the actual role from the database and will flag any
#         mismatch rather than trusting this value.
# <label> is a short name used in the report output (no spaces).
#
# Priority 1 — cross-survivor isolation (the single most important test):
ACCT_1=survivor|survivor-a||
ACCT_2=survivor|survivor-b||

# Priority 2 — jurisdiction boundary (use two DIFFERENT barangays):
ACCT_3=barangay_admin|brgy-admin-a||
ACCT_4=barangay_admin|brgy-admin-b||

# Priority 3-6 — optional, delete any line you are not using:
ACCT_5=municipal_admin|muni-admin||
ACCT_6=support_expert|expert-a||
ACCT_7=support_expert|expert-b||
ACCT_8=law_enforcement|officer||
ACCT_9=shelter_admin|shelter-admin||
