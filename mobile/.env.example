# Copy this file to .env and fill in your SafeHer Supabase project's values.
# These are all EXPO_PUBLIC_ (bundled into the client) — safe to expose
# publicly by design, since Row Level Security is what actually protects
# the data, not secrecy of the anon key. Never put a service_role key or
# any SMTP credential in this file.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
