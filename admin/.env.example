# Copy this file to .env and fill in your SafeHer Supabase project's values.
# These are all VITE_ (bundled into the client) — safe to expose publicly
# by design, since Row Level Security is what actually protects the data,
# not secrecy of the anon key. Never put a service_role key or any SMTP
# credential in this file.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_MAPS_API_KEY=
